# Copy to .env and fill in. Do not commit .env.

APP_ENV=local
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8010
CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# GitHub Pages 联调时追加，例如：https://yourname.github.io

# 若你曾部署过旧版「香港情报」Postgres 模块，可用 psql 连接后执行：
# backend/migrations/002_drop_intelligence.sql

# Intelligence（Sprint 2+）
# INTELLIGENCE_REVIEWER_EMAILS=you@example.com
# 真爬官网（港八大×7类，结构化字段，官方源自动上线）
INTELLIGENCE_FETCH=1
INTELLIGENCE_FETCH_MAX=56
INTELLIGENCE_CRAWL_MODE=real
INTELLIGENCE_RESPECT_ROBOTS=1

# 启动项.bat 预检：同步 feed、按需真爬（默认 12 小时内不重复爬）
STARTUP_INTEL_CRAWL=1
STARTUP_INTEL_CRAWL_MAX_AGE_HOURS=12
# STARTUP_INTEL_CRAWL_FORCE=1
STARTUP_OPEN_BROWSER=1
START_POSTGRES=1
STOP_POSTGRES=1
