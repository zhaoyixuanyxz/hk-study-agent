# Copy to .env.production for docker compose / production host. Do NOT commit .env.production.

APP_ENV=production
NODE_ENV=production
PORT=8010

# Public URL users open in browser (for CORS and share links). Example:
# CORS_ORIGINS=https://study.example.com,https://yourname.github.io
CORS_ORIGINS=http://localhost:8080

# Gateway published port on host (docker-compose.prod.yml)
GATEWAY_HTTP_PORT=8080

# LLM — required for real advisor quality; leave empty only for internal mock testing
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# PDF: unset or 0 to use Chromium in backend image; set 1 to disable PDF endpoints
PDF_DISABLED=0
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Rate limit per IP per minute (0 = off). Recommended for public pilot: 120
APP_RATE_LIMIT_MAX=120

# Optional access log on API
# ENABLE_ACCESS_LOG=1

# Intelligence reviewer emails (comma-separated)
INTELLIGENCE_REVIEWER_EMAILS=you@example.com

# Daily ingestion (0 = mock only, 1 = real HTTP fetch)
INTELLIGENCE_FETCH=0
INTELLIGENCE_FETCH_MAX=10
INTELLIGENCE_RESPECT_ROBOTS=1

# Plan metrics internal endpoint (optional)
# PLAN_METRICS_HTTP_TOKEN=

# Data path inside container (volume mounted at /app/backend/data)
# DATA_FILE=/app/backend/data/db.json
